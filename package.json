{
  "name": "cercle-store",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Store Android gratuit avec catalogue signé sur GitHub Pages et APK dans Releases.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "github:prepare": "node scripts/publish-github.mjs",
    "github:publish": "node scripts/publish-github.mjs --publish"
  },
  "license": "MIT"
}
